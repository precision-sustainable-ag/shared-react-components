# Port this backend listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (the frontend's dev/prod URLs)
CORS_ORIGIN=http://localhost:3000

# Your Auth0 tenant domain (no https://, no trailing slash)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Identifier of the Auth0 API you registered for THIS backend (not the Management API).
# Must match the frontend's VITE_API_AUTH0_AUDIENCE exactly.
AUTH0_AUDIENCE=https://your-admin-portal-api

# Credentials for a Machine-to-Machine application authorized against the
# Auth0 Management API (Applications -> APIs -> Auth0 Management API ->
# Machine to Machine Applications tab), scoped to only:
# read:users, read:roles, read:role_members, create:role_members,
# delete:role_members, update:users
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# Optional overrides (defaults shown)
# AUTH0_MGMT_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/
# ADMIN_ROLE_NAME=Admin
# DEFAULT_ROLE_NAME=User

# "single" = a user holds exactly one role (assigning replaces it).
# "multiple" = a user can hold several roles at once.
# Must match the frontend's VITE_ROLE_ASSIGNMENT_MODE exactly.
ROLE_ASSIGNMENT_MODE=single

# Shown in notification email copy (e.g. "New role request" / "Your <APP_NAME> access...")
APP_NAME=My App

# SMTP settings for admin/user email notifications (leave blank to disable emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Base URL of the frontend, used to build links in notification emails
FRONTEND_URL=http://localhost:3000
